    table.insert(props, {
        Name = "#Walls",
        Type = "integer",
        Value = 1,
        Min = 0,
        Max = 5,
    })

    table.insert(props, { Name = "#Desks", Type = "integer", Value = 0, Min = 0, Max = 5 })
