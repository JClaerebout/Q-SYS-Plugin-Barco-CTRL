            Name = "code",
            ControlType = "Text",
            Count = 1,
            PinStyle = "Input",
            UserPin = true
        })
	end

    table.insert(ctls, {
        Name = "Status",
        ControlType = "Indicator",
		IndicatorType = "Status",
        Count = 1,
        UserPin = true,
        PinStyle = "Output"
    })

    table.insert(ctls, {
        Name = "IP",
        ControlType = "Text",
        Count = 1,
        UserPin = false
    })

    table.insert(ctls, {
        Name = "ClientID",
        ControlType = "Text",
        Count = 1,
        UserPin = false
    })

    table.insert(ctls, {
        Name = "ClientSecret",
        ControlType = "Text",
        Count = 1,
        UserPin = false
    })

    table.insert(ctls, {
        Name = "AccessToken",
        ControlType = "Text",
        Count = 1,
        UserPin = false
    })

    table.insert(ctls, {
        Name = "Compositions",
        ControlType = "Text",
        Count = props["#Walls"].Value,
        UserPin = false
    })

    table.insert(ctls, {
        Name = "WallName",
        ControlType = "Text",
        Count = props["#Walls"].Value,
        UserPin = true,
        PinStyle = "Output"
    })

    table.insert(ctls, {
        Name = "WallPxSize",
        ControlType = "Text",
        Count = props["#Walls"].Value,
        UserPin = true, 
        PinStyle = "Output"
    })

    table.insert(ctls, {
        Name = "WallGridSize",
        ControlType = "Text",
        Count = props["#Walls"].Value,
        UserPin = true, 
        PinStyle = "Output"
    })

    table.insert(ctls, {
        Name = "WallManagerIP",
        ControlType = "Text",
        Count = props["#Walls"].Value,
        UserPin = false
    })

    table.insert(ctls, {
        Name = "WallManagerAuthKey",
        ControlType = "Text",
        Count = props["#Walls"].Value,
        UserPin = false
    })

    table.insert(ctls, {
        Name = "WallManagerStatus",
        ControlType = "Indicator",
		IndicatorType = "Status",
        Count = props["#Walls"].Value,
        UserPin = true,
        PinStyle = "Output"
    })

    table.insert(ctls, {
        Name = "WallBrightness",
        ControlType = "Knob",
        ControlUnit = "Integer",
        Min = 0,
        Max = 100,
        Count = props["#Walls"].Value,
        UserPin = true,
        PinStyle = "Both"
    })

    table.insert(ctls, {
        Name = "WallPower",
        ControlType = "Button",
        ButtonType = "Toggle",
        Count = props["#Walls"].Value,
        UserPin = true,
        PinStyle = "Both",
        Icon = "Power",
    })

    table.insert(ctls, { Name = "WallSelect", ControlType = "Text", Count = props["#Walls"].Value, UserPin = false })
    local deskCount = props["#Desks"] and props["#Desks"].Value or 0
    for _, name in ipairs({ "DeskSelect", "DeskName", "DeskVpxSize", "DeskDisplays" }) do
        if deskCount > 0 then
            table.insert(ctls, { Name = name, ControlType = "Text", Count = deskCount, UserPin = false })
        end
    end
    for _, entry in ipairs({ {"WallDiagram", props["#Walls"].Value}, {"DeskDiagram", deskCount} }) do
        table.insert(ctls, { Name = entry[1], ControlType = "Button", ButtonType = "Toggle", Count = entry[2], UserPin = false })
    end
    -- Omit zero-count definitions (Q-SYS expects a positive Count).
    for i = #ctls, 1, -1 do
        if ctls[i].Count == 0 then table.remove(ctls, i) end
    end

    return ctls
end

------------------------------- Control Layout --------------------------------
function GetControlLayout(props)
    local page = props["page_index"].Value
    local wallCount = math.ceil(props["#Walls"].Value)
    local deskCount = props["#Desks"] and props["#Desks"].Value or 0
    local layout, graphics = {}, {}
    local function label(text, x, y, width)
        table.insert(graphics, { Type = "Label", Text = text, Position = {x,y}, Size = {width,18},
            TextSize = 11, HTextAlign = "Left", Color = {36,55,70} })
    end
    local function section(title, y, height)
        table.insert(graphics, { Type = "GroupBox", Position = {12,y}, Size = {456,height},
            StrokeColor = {191,204,213}, StrokeWidth = 1, CornerRadius = 6 })
        label(title, 24, y + 8, 420)
    end
    local function control(name, title, style, x, y, width, height, readOnly)
        layout[name] = { PrettyName = title, Style = style, Position = {x,y}, Size = {width,height},
            TextFontSize = 11, IsReadOnly = readOnly or false }
    end
    local function name(base, index, count)
        return count == 1 and base or base .. " " .. index
    end
    if ENABLE_CODE_PIN then layout.code = { PrettyName = "Code", Style = "None" } end
    LogoBase64 = ""
    if page == 1 then
        table.insert(graphics, { Type = "Image", Image = LogoBase64, Position = {24,16}, Size = {120,28} })
        label("CTRL | Connection setup", 164, 22, 280)
        section("CTRL server", 60, 196)
        label("Server address", 24, 92, 110)
        control("IP", "CTRL Server Address", "Text", 142, 90, 314, 24)
        label("Client ID", 24, 128, 110)
        control("ClientID", "Client ID", "Text", 142, 126, 314, 24)
        label("Client secret", 24, 164, 110)
        control("ClientSecret", "Client Secret", "Text", 142, 162, 314, 24)
        label("Connection status", 24, 204, 110)
        control("Status", "CTRL Status", "Text", 142, 202, 314, 32, true)
    else
        local isWall = page <= wallCount + 1
        local index = isWall and page - 1 or page - wallCount - 1
        local count = isWall and wallCount or deskCount
        local prefix = isWall and "Wall" or "Desk"
        local function field(base, title, style, x, y, width, height, readOnly)
            control(name(base, index, count), title .. " " .. index, style, x, y, width, height, readOnly)
        end
        section(prefix .. " " .. index .. " | Workplace", 12, 96)
        label("Selected " .. prefix:lower(), 24, 44, 100)
        field(prefix .. "Select", "Select " .. prefix, "ComboBox", 130, 42, 326, 24)
        label(isWall and "Size (pixels)" or "Size (virtual pixels)", 24, 78, 130)
        field(isWall and "WallPxSize" or "DeskVpxSize", prefix .. " Size", "Text", 164, 76, 292, 22, true)
        section("Live preview", 120, isWall and 218 or 278)
        field(prefix .. "Diagram", prefix .. " Preview", "Button", 24, 150, 432, isWall and 156 or 216)
        label("Green: source    Purple: composition", 24, isWall and 312 or 372, 432)
        if isWall then
            section("Recall composition", 350, 142)
            field("Compositions", "Compositions", "ListBox", 24, 378, 432, 102)
            section("Wall Manager", 504, 194)
            label("Server address", 24, 536, 110)
            field("WallManagerIP", "Wall Manager Address", "Text", 142, 534, 314, 24)
            label("Auth key", 24, 568, 110)
            field("WallManagerAuthKey", "Wall Manager Auth Key", "Text", 142, 566, 314, 24)
            label("Status", 24, 602, 110)
            field("WallManagerStatus", "Wall Manager Status", "Text", 142, 600, 314, 26, true)
            label("Brightness", 24, 640, 90)
            field("WallBrightness", "Wall Brightness", "Fader", 114, 636, 236, 28)
            label("Power", 364, 640, 48)
            field("WallPower", "Wall Power", "Button", 416, 634, 40, 32)
        end
    end
    return layout, graphics
end

