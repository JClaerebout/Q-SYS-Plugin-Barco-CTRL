------------------------------ Local Functions --------------------------------
function HEXtoDEC(hex)
	hex = string.upper(hex)
	local b1 = string.byte(string.sub(hex, 1, 1))
	local b2 = string.byte(string.sub(hex, 2, 2))
  
	return( (b1<=57 and b1-48 or b1-55)*16 + (b2<=57 and b2-48 or b2-55) )
end

function ConvertColor(c)
	local t = {}
	t[1] = HEXtoDEC(string.sub(c,2,3))
	t[2] = HEXtoDEC(string.sub(c,4,5))
	t[3] = HEXtoDEC(string.sub(c,6,7))
	return t
end

local function funcSetStatus(value, text)
    -- Successful token/composition calls must not hide incomplete wall discovery.
    if value == 0 and not workplacesLoaded then
        value = workplacesError and workplacesError.value or 5
        text = workplacesError and workplacesError.text or "Discovering walls"
    end
    Controls.Status.Value = value
    Controls.Status.String = text
end

local function funcUrlEncode(value)
    return tostring(value):gsub("[^%w%-_%.~]", function(character)
        return string.format("%%%02X", string.byte(character))
    end)
end

local function funcJsonValue(value)
    return rapidjson.encode(tostring(value or ""))
end

local function funcGetWallControl(controlName, index)
    local control = Controls[controlName]
    if not control then
        return nil
    end

    if WALL_CONTROL_COUNT == 1 then
        return index == 1 and control or nil
    end

    return control[index]
end

local function funcSetWallManagerValue(controlName, index, value)
    local control = funcGetWallControl(controlName, index)
    if control then
        wallManagerControlUpdatesInProgress[index][controlName] = true
        control.Value = value
        wallManagerControlUpdatesInProgress[index][controlName] = false
    end
end

local function funcSetWallManagerStatus(index, value, text)
    local control = funcGetWallControl("WallManagerStatus", index)
    if control then
        control.Value = value
        control.String = text
    end
end

local function funcWallManagerConfigured(index)
    local ipControl = funcGetWallControl("WallManagerIP", index)
    local authKeyControl = funcGetWallControl("WallManagerAuthKey", index)
    return wallsByIndex[index] ~= nil
        and ipControl
        and ipControl.String ~= ""
        and authKeyControl
        and authKeyControl.String ~= ""
end

local function funcClampBrightness(value)
    local brightness = tonumber(value) or 0
    if brightness < 0 then return 0 end
    if brightness > 100 then return 100 end
    return math.floor(brightness)
end

local function funcClampPower(value)
    return (tonumber(value) or 0) == 0 and 0 or 1
end

local function funcPowerToText(value)
    return funcClampPower(value) == 1 and "on" or "idle"
end

local function funcPowerTextToValue(value)
    return tostring(value or ""):lower() == "on" and 1 or 0
end

local function funcLuaPatternEscape(value)
    return tostring(value):gsub("([%^%$%(%)%%%.%[%]%*%+%-%?])", "%%%1")
end

local function funcExtractHeaderValue(headers, headerName)
    if type(headers) == "string" then
        local escapedHeaderName = funcLuaPatternEscape(headerName)
        return headers:match("[\r\n]" .. escapedHeaderName .. ":%s*([^\r\n]+)")
            or headers:match("^" .. escapedHeaderName .. ":%s*([^\r\n]+)")
    end

    if type(headers) ~= "table" then
        return nil
    end

    local target = headerName:lower()
    for key, value in pairs(headers) do
        if type(value) == "table" then
            local name = value.Name or value.name or value.Key or value.key
            local headerValue = value.Value or value.value
            if name and tostring(name):lower() == target then
                return tostring(headerValue or "")
            end
        end

        if tostring(key):lower() == target then
            if type(value) == "table" then
                return table.concat(value, "; ")
            end
            return tostring(value)
        end
    end
    return nil
end

local function funcExtractWallManagerSid(headers, data)
    local cookie = funcExtractHeaderValue(headers, "Set-Cookie") or ""
    local sid = cookie:match("[Ss][Ii][Dd]=([^;%s]+)")
    if sid and sid ~= "" then
        return sid
    end

    local decoded, response = pcall(rapidjson.decode, data or "")
    if decoded and type(response) == "table" then
        return response.sid or response.sessionId or ""
    end
    return ""
end

local function funcScheduleTokenRefresh(delay)
    tokenRefreshTimer:Start(math.max(TOKEN_RETRY_SECONDS, delay))
end


function funcGetToken()
    -- Read the controls here rather than relying on the values at script start.
    ip = Controls.IP.String
    clientID = Controls.ClientID.String
    clientSecret = Controls.ClientSecret.String

    if ip == "" or clientID == "" or clientSecret == "" then
        accessToken = ""
        tokenExpiresAt = 0
        tokenRefreshTimer:Stop()
        compositionPollTimer:Stop()
        funcSetStatus(1, "incomplete")
        return
    end

    -- A valid token is retained until it is within one minute of expiry.
    if accessToken ~= "" and os.time() < (tokenExpiresAt - TOKEN_REFRESH_MARGIN_SECONDS) then
        return accessToken
    end

    if tokenRequestInProgress then
        return
    end

    tokenRequestInProgress = true
    local generation = ctrlGeneration

    local requestIP = ip
    local requestClientID = clientID
    local requestClientSecret = clientSecret
    local url = "https://" .. requestIP .. "/auth/realms/OCS/protocol/openid-connect/token"
    local body = "grant_type=client_credentials"
        .. "&client_id=" .. funcUrlEncode(requestClientID)
        .. "&client_secret=" .. funcUrlEncode(requestClientSecret)

    print("Barco CTRL token request: " .. url)

    HttpClient.Post {
        Url = url,
        Data = body,
        Headers = { ["Content-Type"] = "application/x-www-form-urlencoded" },
        EventHandler = function(_, code, data, err)
        if generation ~= ctrlGeneration then return end
        tokenRequestInProgress = false

        local responseCode = tonumber(code)
        local responseError = err
        if not responseCode
            or (responseError ~= nil and responseError ~= "")
            or responseCode < 200
            or responseCode >= 300 then
            accessToken = ""
            tokenExpiresAt = 0
            if responseCode == 401 then
                funcSetStatus(2, "Unautorized")
            else
                funcSetStatus(4, "Missing")
            end
            print(
                "Barco CTRL token request failed: "
                .. tostring(responseError or responseCode or "unknown error")
                .. " (HTTP " .. tostring(code) .. ")"
            )
            funcScheduleTokenRefresh(TOKEN_RETRY_SECONDS)
            return
        end

        local decoded, tokenInfo = pcall(rapidjson.decode, data)
        local token = decoded and tokenInfo.access_token or nil
        local expiresIn = decoded and tonumber(tokenInfo.expires_in) or DEFAULT_TOKEN_LIFETIME_SECONDS

        if not token or token == "" then
            accessToken = ""
            tokenExpiresAt = 0
            funcSetStatus(4, "Missing")
            print("Barco CTRL token response did not contain an access token")
            funcScheduleTokenRefresh(TOKEN_RETRY_SECONDS)
            return
        end

        accessToken = token
        tokenExpiresAt = os.time() + expiresIn
        funcSetStatus(0, "OK")
        print("Barco CTRL: token received")
        funcGetCompositions()
        funcGetWorkplaces()
        compositionPollTimer:Start(COMPOSITION_POLL_SECONDS)
        for index = 1, WALL_CONTROL_COUNT do
            if pendingCompositionChoices[index] then
                funcRecallComposition(index, pendingCompositionChoices[index])
            end
        end

        -- Match the C# behaviour: refresh 60 seconds before expiry, but never
        -- wait less than five seconds (also handles unusually short lifetimes).
        funcScheduleTokenRefresh(expiresIn - TOKEN_REFRESH_MARGIN_SECONDS)
        end
    }
end

function funcPollCompositions()
    if accessToken ~= "" and os.time() < tokenExpiresAt then
        funcGetCompositions()
        funcGetWorkplaces()
    else
        funcGetToken()
    end
end

function funcGetCompositions()
    if accessToken == "" then
        print("Barco CTRL compositions request skipped: token not ready")
        return
    end

    if compositionRequestInProgress then
        return
    end

    compositionRequestInProgress = true
    local generation = ctrlGeneration

    local url = "https://" .. Controls.IP.String .. "/api/operate/v3/compositions?owner=all"
    local token = accessToken
    print("Barco CTRL compositions request: " .. url)

    HttpClient.Get {
        Url = url,
        Headers = { ["Authorization"] = "Bearer " .. token },
        EventHandler = function(_, code, data, err)
            if generation ~= ctrlGeneration then return end
            compositionRequestInProgress = false

            local responseCode = tonumber(code)
            if not responseCode
                or (err ~= nil and err ~= "")
                or responseCode < 200
                or responseCode >= 300 then
                if responseCode == 401 then
                    funcSetStatus(2, "Unautorized")
                else
                    funcSetStatus(4, "Missing")
                end
                print(
                    "Barco CTRL compositions request failed: "
                    .. tostring(err or responseCode or "unknown error")
                    .. " (HTTP " .. tostring(code) .. ")"
                )
                return
            end

            local decoded, response = pcall(rapidjson.decode, data)
            if not decoded or type(response) ~= "table" or type(response.data) ~= "table" then
                funcSetStatus(4, "Missing")
                print("Barco CTRL compositions response was not valid JSON data")
                return
            end

            compositions = {}
            compositionChoiceNames = {}
            for _, composition in ipairs(response.data) do
                if composition.name and composition.id then
                    compositions[composition.name] = {
                        id = composition.id,
                        width = tonumber(composition.size and composition.size.width) or 0,
                        height = tonumber(composition.size and composition.size.height) or 0
                    }
                end
            end

            compositionChoices = {}

            for _, composition in ipairs(response.data) do
                if composition.name and composition.id then
                    local width = tonumber(composition.size and composition.size.width) or 0
                    local height = tonumber(composition.size and composition.size.height) or 0
                    local choice = composition.name .. " (" .. width .. "x" .. height .. ")"
                    table.insert(compositionChoices, choice)
                    compositionChoiceNames[choice] = composition.name
                end
            end

            for index = 1, WALL_CONTROL_COUNT do
                local compositionsControl = funcGetWallControl("Compositions", index)
                if wallsByIndex[index] then
                    compositionsControl.Choices = compositionChoices
                else
                    compositionsControl.Choices = {}
                end
            end

            for name, composition in pairs(compositions) do
                print(
                    "Barco CTRL composition: " .. name
                    .. " = " .. composition.id
                    .. " (" .. composition.width .. "x" .. composition.height .. ")"
                )
            end
            funcSetStatus(0, "OK")
        end
    }
end

function funcGetWorkplaces()
    if workplacesLoaded or workplacesRequestInProgress or accessToken == "" then
        return
    end

    workplacesRequestInProgress = true
    local generation = ctrlGeneration

    local url = "https://" .. Controls.IP.String .. "/api/operate/v3/workplaces?type=Wall"
    local token = accessToken
    print("Barco CTRL workplaces request: " .. url)

    HttpClient.Get {
        Url = url,
        Headers = { ["Authorization"] = "Bearer " .. token },
        EventHandler = function(_, code, data, err)
            if generation ~= ctrlGeneration then return end
            workplacesRequestInProgress = false

            local responseCode = tonumber(code)
            if not responseCode
                or (err ~= nil and err ~= "")
                or responseCode < 200
                or responseCode >= 300 then
                workplacesError = {
                    value = responseCode == 401 and 2 or 4,
                    text = responseCode == 401 and "Unauthorized" or "Wall discovery failed"
                }
                funcSetStatus(workplacesError.value, workplacesError.text)
                compositionPollTimer:Start(TOKEN_RETRY_SECONDS)
                print(
                    "Barco CTRL workplaces request failed: "
                    .. tostring(err or responseCode or "unknown error")
                    .. " (HTTP " .. tostring(code) .. ")"
                )
                return
            end

            local decoded, response = pcall(rapidjson.decode, data)
            if not decoded or type(response) ~= "table" or type(response.data) ~= "table" then
                workplacesError = { value = 4, text = "Invalid wall discovery response" }
                funcSetStatus(workplacesError.value, workplacesError.text)
                compositionPollTimer:Start(TOKEN_RETRY_SECONDS)
                print("Barco CTRL workplaces response was not valid JSON data")
                return
            end

            workplaces = {}
            wallsByIndex = {}
            for index = 1, WALL_CONTROL_COUNT do
                funcGetWallControl("WallName", index).String = ""
                funcGetWallControl("WallPxSize", index).String = ""
                funcGetWallControl("WallGridSize", index).String = ""
                funcGetWallControl("Compositions", index).Choices = {}
            end

            local wallIndex = 0
            for _, workplace in ipairs(response.data) do
                if workplace.name and workplace.id then
                    local size = workplace.wallGeometry and workplace.wallGeometry.sizePx or {}
                    local grid = workplace.wallGeometry and workplace.wallGeometry.grid or {}
                    workplaces[workplace.name] = {
                        id = workplace.id,
                        type = workplace.type,
                        sizePx = {
                            width = tonumber(size.width) or 0,
                            height = tonumber(size.height) or 0
                        },
                        grid = {
                            columns = tonumber(grid.columns) or 0,
                            rows = tonumber(grid.rows) or 0
                        }
                    }

                    wallIndex = wallIndex + 1
                    if wallIndex <= WALL_CONTROL_COUNT then
                        wallsByIndex[wallIndex] = workplaces[workplace.name]
                        funcGetWallControl("WallName", wallIndex).String = workplace.name
                        funcGetWallControl("WallPxSize", wallIndex).String = tostring(size.width or 0)
                            .. "x" .. tostring(size.height or 0)
                        funcGetWallControl("WallGridSize", wallIndex).String = tostring(grid.columns or 0)
                            .. "x" .. tostring(grid.rows or 0)
                    end

                    print(
                        "Barco CTRL workplace: " .. workplace.name
                        .. " = " .. workplace.id
                        .. " (" .. tostring(size.width or 0)
                        .. "x" .. tostring(size.height or 0)
                        .. ", " .. tostring(grid.columns or 0)
                        .. "x" .. tostring(grid.rows or 0) .. " grid)"
                    )
                end
            end

            for index = 1, WALL_CONTROL_COUNT do
                if wallsByIndex[index] then
                    funcGetWallControl("Compositions", index).Choices = compositionChoices
                end
            end

            workplacesLoaded = true
            workplacesError = nil
            compositionPollTimer:Start(COMPOSITION_POLL_SECONDS)
            funcRefreshWallManagers()
            funcSetStatus(0, "OK")
        end
    }
end

function funcRecallComposition(wallIndex, selectedChoice)
    selectedChoice = selectedChoice or funcGetWallControl("Compositions", wallIndex).String
    local compositionName = compositionChoiceNames[selectedChoice]
    local composition = compositionName and compositions[compositionName]
    local wall = wallsByIndex[wallIndex]

    if not composition then
        print("Barco CTRL recall ignored: no valid composition selected for wall " .. wallIndex)
        return
    end

    if not wall then
        print("Barco CTRL recall ignored: no wall configured at index " .. wallIndex)
        return
    end
    pendingCompositionChoices[wallIndex] = selectedChoice
    if contentRequestInProgress[wallIndex] then
        return
    end


    if accessToken == "" or os.time() >= tokenExpiresAt then
        funcSetStatus(5, "Initializing")
        print("Barco CTRL recall deferred: token not ready")
        funcGetToken()
        return
    end

    contentRequestInProgress[wallIndex] = true
    pendingCompositionChoices[wallIndex] = nil
    local generation = ctrlGeneration

    local url = "https://" .. Controls.IP.String .. "/api/operate/v3/workplaces/" .. wall.id .. "/content"
    local body = rapidjson.encode({
        {
            geometry = {
                type = "px",
                x = 0,
                y = 0,
                width = composition.width,
                height = composition.height
            },
            content = {
                type = "Composition",
                id = composition.id
            },
            window = {
                showFrame = false,
                title = compositionName
            }
        }
    })

    print("Barco CTRL recall request: " .. url)

    HttpClient.Put {
        Url = url,
        Data = body,
        Headers = {
            ["Authorization"] = "Bearer " .. accessToken,
            ["Content-Type"] = "application/json"
        },
        EventHandler = function(_, code, _, err)
            if generation ~= ctrlGeneration then return end
            contentRequestInProgress[wallIndex] = false

            local responseCode = tonumber(code)
            if not responseCode
                or (err ~= nil and err ~= "")
                or responseCode < 200
                or responseCode >= 300 then
                if responseCode == 401 then
                    funcSetStatus(2, "Unautorized")
                else
                    funcSetStatus(4, "Missing")
                end
                print(
                    "Barco CTRL recall failed for wall " .. wallIndex .. ": "
                    .. tostring(err or responseCode or "unknown error")
                    .. " (HTTP " .. tostring(code) .. ")"
                )
            else
                print("Barco CTRL composition recalled on wall " .. wallIndex)
                funcSetStatus(0, "OK")
            end

            if pendingCompositionChoices[wallIndex] then
                funcRecallComposition(wallIndex, pendingCompositionChoices[wallIndex])
            end
        end
    }
end

function funcWallManagerDisconnect(wallIndex, statusText)
    wallManagerTimers[wallIndex]:Stop()
    wallManagerSessions[wallIndex] = { sid = "", expiresAt = 0 }
    -- Replacing this table also invalidates outstanding authentication and API callbacks.
    wallManagerRequestsInProgress[wallIndex] = { pending = {} }
    wallManagerControlUpdatesInProgress[wallIndex] = {}
    funcSetWallManagerValue("WallBrightness", wallIndex, 0)
    funcSetWallManagerValue("WallPower", wallIndex, 0)
    funcSetWallManagerStatus(wallIndex, 0, statusText or "Disabled")
end

function funcRefreshWallManager(wallIndex)
    if not wallsByIndex[wallIndex] then
        funcWallManagerDisconnect(wallIndex, "No Wall")
        return
    end

    if not funcWallManagerConfigured(wallIndex) then
        funcWallManagerDisconnect(wallIndex, "Disabled")
        return
    end

    funcSetWallManagerStatus(wallIndex, 5, "Initializing")
    funcWallManagerPoll(wallIndex)
end

function funcRefreshWallManagers()
    for index = 1, WALL_CONTROL_COUNT do
        funcRefreshWallManager(index)
    end
end

function funcWallManagerSchedulePoll(wallIndex, delay)
    if funcWallManagerConfigured(wallIndex) then
        wallManagerTimers[wallIndex]:Start(math.max(WALL_MANAGER_RETRY_SECONDS, delay or WALL_MANAGER_POLL_SECONDS))
    end
end

function funcWallManagerEnsureSession(wallIndex, callback, requestName)
    if not funcWallManagerConfigured(wallIndex) then
        funcRefreshWallManager(wallIndex)
        return
    end

    local session = wallManagerSessions[wallIndex]
    if session.sid ~= "" and os.time() < (session.expiresAt - WALL_MANAGER_SESSION_MARGIN_SECONDS) then
        if callback then callback() end
        return
    end

    local requests = wallManagerRequestsInProgress[wallIndex]
    -- Keep the latest request of each kind while authentication is pending.
    requests.pending[requestName] = callback
    if requests.session then
        return
    end

    requests.session = true

    local requestIP = funcGetWallControl("WallManagerIP", wallIndex).String
    local requestAuthKey = funcGetWallControl("WallManagerAuthKey", wallIndex).String
    local url = "https://" .. requestIP .. "/api/v1/auth/key"
    local body = "{\"type\":\"REST\",\"key\":" .. funcJsonValue(requestAuthKey) .. "}"

    print("Barco Wall Manager " .. wallIndex .. " session request: " .. url)

    HttpClient.Post {
        Url = url,
        Data = body,
        Headers = { ["Content-Type"] = "application/json" },
        EventHandler = function(response, code, data, err, headers)
            if requests ~= wallManagerRequestsInProgress[wallIndex] then return end
            requests.session = false

            if not funcWallManagerConfigured(wallIndex)
                or funcGetWallControl("WallManagerIP", wallIndex).String ~= requestIP
                or funcGetWallControl("WallManagerAuthKey", wallIndex).String ~= requestAuthKey then
                funcRefreshWallManager(wallIndex)
                return
            end

            local responseCode = tonumber(code)
            if not responseCode
                or (err ~= nil and err ~= "")
                or responseCode < 200
                or responseCode >= 300 then
                wallManagerSessions[wallIndex] = { sid = "", expiresAt = 0 }
                funcSetWallManagerStatus(wallIndex, responseCode == 401 and 2 or 4, responseCode == 401 and "Unauthorized" or "Missing")
                print(
                    "Barco Wall Manager " .. wallIndex .. " session failed: "
                    .. tostring(err or responseCode or "unknown error")
                    .. " (HTTP " .. tostring(code) .. ")"
                )
                funcWallManagerSchedulePoll(wallIndex, WALL_MANAGER_RETRY_SECONDS)
                return
            end

            local sid = funcExtractWallManagerSid(headers or (response and response.Headers), data)
            local expiresIn = DEFAULT_WALL_MANAGER_SESSION_SECONDS
            local decoded, response = pcall(rapidjson.decode, data or "")
            if decoded and type(response) == "table" then
                expiresIn = tonumber(response.expiresIn) or DEFAULT_WALL_MANAGER_SESSION_SECONDS
            end

            if sid == "" then
                wallManagerSessions[wallIndex] = { sid = "", expiresAt = 0 }
                funcSetWallManagerStatus(wallIndex, 4, "Missing SID")
                print("Barco Wall Manager " .. wallIndex .. " session response had no sid")
                funcWallManagerSchedulePoll(wallIndex, WALL_MANAGER_RETRY_SECONDS)
                return
            end

            wallManagerSessions[wallIndex] = { sid = sid, expiresAt = os.time() + expiresIn }
            funcSetWallManagerStatus(wallIndex, 0, "OK")
            print("Barco Wall Manager " .. wallIndex .. ": session received")
            local pending = requests.pending
            requests.pending = {}
            for _, resume in pairs(pending) do resume() end
            funcWallManagerSchedulePoll(
                wallIndex,
                math.max(WALL_MANAGER_RETRY_SECONDS, math.min(WALL_MANAGER_POLL_SECONDS, expiresIn - WALL_MANAGER_SESSION_MARGIN_SECONDS))
            )
        end
    }
end

function funcWallManagerAuthenticatedRequest(wallIndex, method, path, body, requestName, callback)
    funcWallManagerEnsureSession(wallIndex, function()
        local requests = wallManagerRequestsInProgress[wallIndex]
        local session = wallManagerSessions[wallIndex]
        if session.sid == "" then
            print("Barco Wall Manager " .. wallIndex .. " " .. requestName .. " skipped: session not ready")
            return
        end

        local requestIP = funcGetWallControl("WallManagerIP", wallIndex).String
        local url = "https://" .. requestIP .. path
        local request = {
            Url = url,
            Headers = {
                ["key"] = session.sid,
                ["Cookie"] = "sid=" .. session.sid,
                ["Content-Type"] = "application/json"
            },
            EventHandler = function(_, code, data, err)
                if requests ~= wallManagerRequestsInProgress[wallIndex]
                    or session ~= wallManagerSessions[wallIndex] then
                    return
                end
                local responseCode = tonumber(code)
                if not responseCode
                    or (err ~= nil and err ~= "")
                    or responseCode < 200
                    or responseCode >= 300 then
                    if responseCode == 401 or responseCode == 403 then
                        wallManagerSessions[wallIndex] = { sid = "", expiresAt = 0 }
                    end
                    funcSetWallManagerStatus(wallIndex, (responseCode == 401 or responseCode == 403) and 2 or 4, (responseCode == 401 or responseCode == 403) and "Unauthorized" or "Missing")
                    print(
                        "Barco Wall Manager " .. wallIndex .. " " .. requestName .. " failed: "
                        .. tostring(err or responseCode or "unknown error")
                        .. " (HTTP " .. tostring(code) .. ")"
                    )
                    funcWallManagerSchedulePoll(wallIndex, WALL_MANAGER_RETRY_SECONDS)
                    return
                end

                funcSetWallManagerStatus(wallIndex, 0, "OK")
                if callback then callback(data) end
            end
        }

        if body then
            request.Data = body
        end

        print("Barco Wall Manager " .. wallIndex .. " " .. requestName .. " request: " .. url)
        if method == "POST" then
            HttpClient.Post(request)
        else
            HttpClient.Get(request)
        end
    end, requestName)
end

function funcWallManagerPoll(wallIndex)
    if not funcWallManagerConfigured(wallIndex) then
        funcRefreshWallManager(wallIndex)
        return
    end

    funcWallManagerAuthenticatedRequest(wallIndex, "GET", "/api/v1/wall/brightness", nil, "brightness GET", function(data)
        local decoded, response = pcall(rapidjson.decode, data or "")
        if decoded and type(response) == "table" then
            funcSetWallManagerValue("WallBrightness", wallIndex, funcClampBrightness(response.brightness))
        end
    end)

    funcWallManagerAuthenticatedRequest(wallIndex, "GET", "/api/v1/wall/power", nil, "power GET", function(data)
        local decoded, response = pcall(rapidjson.decode, data or "")
        if decoded and type(response) == "table" then
            funcSetWallManagerValue("WallPower", wallIndex, funcPowerTextToValue(response.power))
        end
    end)

    funcWallManagerSchedulePoll(wallIndex, WALL_MANAGER_POLL_SECONDS)
end

function funcSetWallManagerBrightness(wallIndex)
    if wallManagerControlUpdatesInProgress[wallIndex].WallBrightness then
        return
    end

    if not funcWallManagerConfigured(wallIndex) then
        funcRefreshWallManager(wallIndex)
        return
    end

    local brightness = funcClampBrightness(funcGetWallControl("WallBrightness", wallIndex).Value)
    local body = "{\"brightness\":" .. brightness .. "}"
    funcSetWallManagerValue("WallBrightness", wallIndex, brightness)
    funcWallManagerAuthenticatedRequest(wallIndex, "POST", "/api/v1/wall/brightness", body, "brightness POST")
end

function funcSetWallManagerPower(wallIndex)
    if wallManagerControlUpdatesInProgress[wallIndex].WallPower then
        return
    end

    if not funcWallManagerConfigured(wallIndex) then
        funcRefreshWallManager(wallIndex)
        return
    end

    local power = funcClampPower(funcGetWallControl("WallPower", wallIndex).Value)
    local body = "{\"power\":" .. funcJsonValue(funcPowerToText(power)) .. "}"
    funcSetWallManagerValue("WallPower", wallIndex, power)
    funcWallManagerAuthenticatedRequest(wallIndex, "POST", "/api/v1/wall/power", body, "power POST")
end


local function funcRegisterWallControlHandlers()
    for index = 1, WALL_CONTROL_COUNT do
        local wallIndex = index
        local compositionsControl = funcGetWallControl("Compositions", wallIndex)
        local ipControl = funcGetWallControl("WallManagerIP", wallIndex)
        local authKeyControl = funcGetWallControl("WallManagerAuthKey", wallIndex)
        local brightnessControl = funcGetWallControl("WallBrightness", wallIndex)
        local powerControl = funcGetWallControl("WallPower", wallIndex)

        wallManagerTimers[wallIndex].EventHandler = function()
            funcWallManagerPoll(wallIndex)
        end

        compositionsControl.EventHandler = function()
            funcRecallComposition(wallIndex)
        end

        if ipControl then
            ipControl.EventHandler = function()
                funcWallManagerDisconnect(wallIndex)
                funcRefreshWallManager(wallIndex)
            end
        end

        if authKeyControl then
            authKeyControl.EventHandler = function()
                funcWallManagerDisconnect(wallIndex)
                funcRefreshWallManager(wallIndex)
            end
        end

        if brightnessControl then
            brightnessControl.EventHandler = function()
                funcSetWallManagerBrightness(wallIndex)
            end
        end

        if powerControl then
            powerControl.EventHandler = function()
                funcSetWallManagerPower(wallIndex)
            end
        end
    end
end

function funcCheckValueCompleteness()
    -- A settings change makes the current token invalid for future API calls.
    ctrlGeneration = ctrlGeneration + 1
    tokenRequestInProgress = false
    compositionRequestInProgress = false
    workplacesRequestInProgress = false
    tokenRefreshTimer:Stop()
    accessToken = ""
    tokenExpiresAt = 0
    compositionPollTimer:Stop()
    workplacesLoaded = false
    workplacesError = nil
    compositions = {}
    compositionChoiceNames = {}
    compositionChoices = {}
    workplaces = {}
    wallsByIndex = {}
    contentRequestInProgress = {}
    pendingCompositionChoices = {}
    for index = 1, WALL_CONTROL_COUNT do
        funcGetWallControl("WallName", index).String = ""
        funcGetWallControl("WallPxSize", index).String = ""
        funcGetWallControl("WallGridSize", index).String = ""
        funcGetWallControl("Compositions", index).Choices = {}
        funcGetWallControl("Compositions", index).String = ""
    end
    funcRefreshWallManagers()
    if Controls.IP.String == "" or Controls.ClientID.String == "" or Controls.ClientSecret.String == "" then
        funcSetStatus(1, "incomplete")
    else
        funcSetStatus(5, "Initializing")
    end
    funcGetToken()
end


------------------------------- Runtime Logic ---------------------------------

if Controls then
------------------------------------ Objects ----------------------------------


-------------------------------- Initialization -------------------------------
function Initialize()
	-- Do initialization stuff here
    rapidjson = require("rapidjson")

    ip = Controls.IP.String
    clientID = Controls.ClientID.String
    clientSecret = Controls.ClientSecret.String

    -- Kept globally so subsequent API calls can use:
    -- "Authorization", "Bearer " .. accessToken
    accessToken = ""
    tokenExpiresAt = 0
    ctrlGeneration = 0
    tokenRequestInProgress = false
    compositionRequestInProgress = false
    compositions = {}
    compositionChoiceNames = {}
    compositionChoices = {}
    workplacesRequestInProgress = false
    workplacesLoaded = false
    workplacesError = nil
    workplaces = {}
    wallsByIndex = {}
    contentRequestInProgress = {}
    pendingCompositionChoices = {}

    TOKEN_REFRESH_MARGIN_SECONDS = 60
    TOKEN_RETRY_SECONDS = 5
    DEFAULT_TOKEN_LIFETIME_SECONDS = 600
    COMPOSITION_POLL_SECONDS = 60
    WALL_CONTROL_COUNT = math.ceil(tonumber(Properties["#Walls"].Value) or 1)
    WALL_MANAGER_POLL_SECONDS = 60
    WALL_MANAGER_RETRY_SECONDS = 5
    WALL_MANAGER_SESSION_MARGIN_SECONDS = 60
    DEFAULT_WALL_MANAGER_SESSION_SECONDS = 1800

    tokenRefreshTimer = Timer.New()
    compositionPollTimer = Timer.New()
    wallManagerTimers = {}
    wallManagerSessions = {}
    wallManagerRequestsInProgress = {}
    wallManagerControlUpdatesInProgress = {}

    for index = 1, WALL_CONTROL_COUNT do
        wallManagerTimers[index] = Timer.New()
        wallManagerSessions[index] = { sid = "", expiresAt = 0 }
        wallManagerRequestsInProgress[index] = { pending = {} }
        wallManagerControlUpdatesInProgress[index] = {}
    end

    funcRegisterWallControlHandlers()
    tokenRefreshTimer.EventHandler = funcGetToken
    compositionPollTimer.EventHandler = funcPollCompositions

    funcCheckValueCompleteness()
    Controls.IP.EventHandler = funcCheckValueCompleteness
    Controls.ClientID.EventHandler = funcCheckValueCompleteness
    Controls.ClientSecret.EventHandler = funcCheckValueCompleteness
end

local canInitialize = true

-- Check Properties and other stuff for illegal values

if canInitialize then
	print("Initializing")
	Initialize()
	print("Initialization Complete")
else
	print("Not initializing")
end

-- Nothing should be done after this point

end	--if Controls 
